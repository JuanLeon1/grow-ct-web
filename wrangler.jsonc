{
  // Cloudflare Workers config — serves the site as static assets.
  // Deploy:  npx wrangler deploy
  // Preview: npx wrangler dev
  "name": "grow-ct-web",
  "compatibility_date": "2026-09-01",

  // Pinned explicitly: these default to true, but `wrangler deploy` overrides
  // dashboard toggles on every push, so keep the intent in the file.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "."
  }
  // When you add dynamic endpoints later, add:
  //   "main": "src/index.js",
  //   "assets": { "directory": ".", "binding": "ASSETS" }
  // and bind D1 / KV / R2 here.
}
